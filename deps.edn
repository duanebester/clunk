;; clunk itself needs nothing beyond Clojure. clunk.async needs core.async,
;; which its users add themselves; the aliases that use it add it here, and
;; build.clj lists it in the pom as optional.
{:deps  {}

 :paths ["src"]

 :aliases {:dev   {:extra-paths ["src/clunk"]
                   :extra-deps {http-kit/http-kit {:mvn/version "2.1.19"}
                                org.clojure/data.json {:mvn/version "2.4.0"}}}
           ;; clojure -T:build jar | install | deploy
           :build {:deps {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}
                          slipset/deps-deploy {:mvn/version "0.2.5"}}
                   :ns-default build}
           ;; clojure -M:stress [seconds] [workers]: pool stress test, not in the suite
           :stress {:extra-paths ["stress"]
                    :extra-deps {org.clojure/core.async {:mvn/version "1.9.865"}}
                    :jvm-opts ["-Xmx1g"]
                    :main-opts ["-m" "clunk.stress"]}
           ;; clojure -M:bench [seconds]: one client's read throughput, not in the suite
           :bench {:extra-paths ["stress"]
                   :extra-deps {org.clojure/core.async {:mvn/version "1.9.865"}}
                   :jvm-opts ["-Xmx1g"]
                   :main-opts ["-m" "clunk.bench"]}
           ;; clojure -M:cljs compile node | test | stress | bench
           :cljs  {:extra-paths ["test" "stress"]
                   :extra-deps {thheller/shadow-cljs {:mvn/version "3.5.11"}
                                org.clojure/core.async {:mvn/version "1.9.865"}}
                   :main-opts ["-m" "shadow.cljs.devtools.cli"]}
           :test  {:extra-paths ["test"]
                   :extra-deps {io.github.cognitect-labs/test-runner
                                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                                org.clojure/core.async {:mvn/version "1.9.865"}}
                   :main-opts ["-m" "cognitect.test-runner"]
                   :exec-fn cognitect.test-runner.api/test}}}
