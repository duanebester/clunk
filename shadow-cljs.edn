;; clojure -M:cljs compile node   -> target/node/clunk.js, a CommonJS module
;; clojure -M:cljs compile test && node target/test/node-tests.js
;;                                -> runs the .cljc tests on Node
{:deps   {:aliases [:cljs]}
 :builds {:node {:target    :node-library
                 :output-to "target/node/clunk.js"
                 :exports   {:connect clunk.node/connect
                             :pool    clunk.node/pool
                             :query   clunk.node/query
                             :stream  clunk.node/stream
                             :close   clunk.node/close}}
          ;; Pool stress test, not in the suite; see stress/clunk/stress.cljs.
          :stress {:target    :node-script
                   :main      clunk.stress/main
                   :output-to "target/stress/stress.js"}
          :test {:target    :node-test
                 :output-to "target/test/node-tests.js"
                 :ns-regexp "-test$"}}}
